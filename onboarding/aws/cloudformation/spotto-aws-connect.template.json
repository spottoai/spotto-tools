                    "Fn::Equals": [
                      {
                        "Ref": "Deployment"
                      },
                      "prod-us"
                    ]
                  },
                  {
                    "Fn::Equals": [
                      {
                        "Ref": "AWS::Region"
                      },
                      "us-east-1"
                    ]
                  },
                  {
                    "Fn::Equals": [
                      {
                        "Ref": "RegistrationTopicArn"
                      },
                      "arn:aws:sns:us-east-1:715809501612:spotto-aws-connect-prod-us"
                    ]
                  },
                  {
                    "Fn::Equals": [
                      {
                        "Ref": "BillingExportName"
                      },
                      "spotto-cur2-prod-us"
                    ]
                  }
                ]
              },
              {
                "Fn::And": [
                  {
                    "Fn::Equals": [
                      {
                        "Ref": "Deployment"
                      },
                      "prod-eu"
                    ]
                  },
                  {
                    "Fn::Equals": [
                      {
                        "Ref": "AWS::Region"
                      },
                      "eu-north-1"
                    ]
                  },
                  {
                    "Fn::Equals": [
                      {
                        "Ref": "RegistrationTopicArn"
                      },
                      "arn:aws:sns:eu-north-1:715809501612:spotto-aws-connect-prod-eu"
                    ]
                  },
                  {
                    "Fn::Equals": [
                      {
                        "Ref": "BillingExportName"
                      },
                      "spotto-cur2-prod-eu"
                    ]
                  }
                ]
              }
            ]
          },
          "AssertDescription": "Use the deployment, region, registration topic and export name supplied together by the Spotto portal."
        }
      ]
    }
  },
  "Conditions": {
    "CreateExport": {
      "Fn::Equals": [
        {
          "Ref": "CostData"
        },
        "CreateExport"
      ]
    }
  },
