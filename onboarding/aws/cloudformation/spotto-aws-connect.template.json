                  "Version": "2012-10-17",
                  "Statement": [
                    {
                      "Sid": {
                        "Fn::Sub": "ReadBucketLocationV202610301${RepairToken}"
                      },
                      "Effect": "Allow",
                      "Action": "s3:GetBucketLocation",
                      "Resource": {
                        "Fn::Sub": "arn:aws:s3:::${BillingBucket}"
                      }
                    },
                    {
                      "Sid": {
                        "Fn::Sub": "ListDeliveryRootV202610301${RepairToken}"
                      },
                      "Effect": "Allow",
                      "Action": "s3:ListBucket",
                      "Resource": {
                        "Fn::Sub": "arn:aws:s3:::${BillingBucket}"
                      },
                      "Condition": {
                        "StringLike": {
                          "s3:prefix": [
                            {
                              "Fn::Sub": "cur2/${BillingExportName}"
                            },
                            {
                              "Fn::Sub": "cur2/${BillingExportName}/*"
                            }
                          ]
                        }
                      }
                    },
                    {
                      "Sid": {
                        "Fn::Sub": "ReadDeliveryObjectsV202610301${RepairToken}"
                      },
                      "Effect": "Allow",
                      "Action": "s3:GetObject",
                      "Resource": {
