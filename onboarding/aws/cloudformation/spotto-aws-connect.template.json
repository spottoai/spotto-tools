{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Regional read-only access, private billing storage and isolated registration. Export definitions use a separate billing stack.",
  "Metadata": {
    "GeneratedBy": "api/scripts/aws/generate-connect-templates.ts",
    "TemplateVersion": "2026-10-30.1",
