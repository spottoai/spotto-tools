                  },
                  {
                    "Fn::Equals": [
                      {
                        "Ref": "BillingExportName"
                      },
                      "spotto-cur2-dev-au"
                    ]
                  }
                ]
              },
              {
                "Fn::And": [
                  {
                    "Fn::Equals": [
                      {
                        "Ref": "Deployment"
                      },
                      "prod-au"
                    ]
                  },
                  {
                    "Fn::Equals": [
                      {
                        "Ref": "AWS::Region"
                      },
                      "ap-southeast-2"
                    ]
                  },
                  {
                    "Fn::Equals": [
                      {
                        "Ref": "RegistrationTopicArn"
                      },
                      "arn:aws:sns:ap-southeast-2:715809501612:spotto-aws-connect-prod-au"
                    ]
                  },
                  {
                    "Fn::Equals": [
                      {
                        "Ref": "BillingExportName"
                      },
                      "spotto-cur2-prod-au"
                    ]
