  },
  "Parameters": {
    "ExternalId": {
      "Type": "String",
      "AllowedPattern": "^spotto-[0-9a-f-]{36}$",
      "ConstraintDescription": "Use the External ID shown in the portal.",
      "Description": "External ID shown in the portal. The role can only be assumed with this value."
    },
    "TrustedPrincipalArn": {
      "Type": "String",
      "AllowedPattern": "^arn:aws:iam::(\\d{12}):(user|role)\\/[A-Za-z0-9+=,.@_/-]{1,512}$",
      "ConstraintDescription": "Use the trusted principal ARN shown in the portal.",
      "Description": "IAM user or role ARN, shown in the portal, that is allowed to assume the role."
    },
    "Deployment": {
      "Type": "String",
      "AllowedValues": [
        "dev-au",
        "prod-au",
        "prod-us",
        "prod-eu"
      ],
      "Description": "Deployment shown in the portal. Do not change it independently of the registration topic."
    },
    "RegistrationTopicArn": {
      "Type": "String",
      "AllowedValues": [
        "arn:aws:sns:ap-southeast-2:715809501612:spotto-aws-connect-dev-au",
        "arn:aws:sns:ap-southeast-2:715809501612:spotto-aws-connect-prod-au",
        "arn:aws:sns:us-east-1:715809501612:spotto-aws-connect-prod-us",
        "arn:aws:sns:eu-north-1:715809501612:spotto-aws-connect-prod-eu"
      ],
      "Description": "Regional registration topic shown in the portal."
    },
    "BillingExportName": {
      "Type": "String",
      "AllowedPattern": "^spotto-cur2-(dev-au|prod-au|prod-us|prod-eu)$",
      "Description": "Billing export name shown in the portal."
    },
    "CostData": {
      "Type": "String",
      "AllowedValues": [
        "CreateExport",
        "None"
      ],
      "Default": "CreateExport",
      "Description": "CreateExport prepares regional storage and read access for the separate billing-export stack. None creates the role only."
    },
    "RetainedBillingStorage": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [
        "false",
        "true"
      ],
      "Description": "Recovery only: resume retained regional storage through the separate billing-access stack. Leave false for new connections."
    },
    "RoleName": {
      "Type": "String",
      "AllowedPattern": "^[A-Za-z0-9+=,.@_-]{1,64}$",
      "Description": "Name of the read-only IAM role."
    },
    "RepairToken": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^[0-9]{0,14}$",
      "ConstraintDescription": "Use up to 14 digits, for example the current time in epoch seconds.",
      "Description": "Leave empty. Change it (for example to the current epoch seconds) to re-apply the role trust and policies."
    }
  },
  "Rules": {
    "RetainedStorageRecovery": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Or": [
              {
                "Fn::Equals": [
                  {
                    "Ref": "RetainedBillingStorage"
                  },
                  "false"
                ]
              },
              {
                "Fn::Equals": [
                  {
                    "Ref": "CostData"
                  },
                  "None"
                ]
              }
            ]
          },
          "AssertDescription": "Retained storage recovery requires a role-only stack; storage must not be recreated."
        }
      ]
    },
    "OnboardingBoundary": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Or": [
              {
                "Fn::And": [
                  {
                    "Fn::Equals": [
                      {
                        "Ref": "Deployment"
                      },
                      "dev-au"
                    ]
                  },
                  {
                    "Fn::Equals": [
                      {
                        "Ref": "AWS::Region"
